<Page x:Class="PhotoViewer.ImagePreviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="画像プレビュー">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<StackPanel Orientation="Horizontal" Margin="10" Grid.Row="0">
			<Button Content="←" Click="CloseButton_Click" Width="120" Height="30"/>
		</StackPanel>
		<Image x:Name="PreviewImage" Stretch="Uniform" Grid.Row="1"/>
	</Grid>
</Page>